generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  apiToken  String?    @unique @default(uuid())
  instances Instance[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Instance {
  id         String   @id @default(uuid())
  name       String   @unique
  status        String   @default("DISCONNECTED") // DISCONNECTED, CONNECTING, CONNECTED
  webhookUrl    String?
  webhookEvents String[] @default([])
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  chats         Chat[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  agent      Agent?
}

model Agent {
  id            String   @id @default(uuid())
  instanceId    String   @unique
  instance      Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  
  name          String?  @default("Agente IA")
  objective     String?
  process       String?
  observations  String?  
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Chat {
  id            String    @id @default(uuid())
  instanceId    String
  instance      Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  remoteJid     String
  name          String?   // Contact or group name
  profilePicUrl String?   // Contact or group profile picture URL
  unreadCount   Int       @default(0)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]

  @@unique([instanceId, remoteJid])
}

model Message {
  id            String   @id @default(uuid())
  chatId        String
  chat          Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId     String   // Message ID from WhatsApp/Baileys
  text          String?
  type          String   // 'text', 'image', 'video', 'audio', 'document', 'sticker', etc.
  mediaUrl      String?  // Local server path to media file
  mimetype      String?
  fromMe        Boolean  @default(false)
  participant   String?  // Sender JID in groups
  participantName String? // Sender Name
  participantThumb String? // Sender Profile picture url
  timestamp     DateTime @default(now())
  status        String   @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chatId, messageId])
}
